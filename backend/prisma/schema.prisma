generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id        Int       @id @default(autoincrement())
  nombre    String
  correo    String    @unique
  password  String
  rol       Rol       @default(INSTRUCTOR)
  fichas    Ficha[]   @relation("InstructorFichas")
  aprobaciones Ficha[] @relation("CoordinadorAprobaciones")
}

model Ficha {
  id           Int      @id @default(autoincrement())
  codigo       String   @unique
  programa     String
  duracion     Int
  modalidad    String
  fechaInicio  DateTime
  fechaFin     DateTime
  estado       String   @default("pendiente")
  observacion  String?  // Para comentarios del coordinador
  createdAt    DateTime @default(now())

  // Relación con Instructor
  instructorId Int
  instructor   Usuario   @relation("InstructorFichas", fields: [instructorId], references: [id])

  // Relación con Coordinador (opcional)
  coordinadorId Int? 
  coordinador   Usuario? @relation("CoordinadorAprobaciones", fields: [coordinadorId], references: [id])
}

enum Rol {
  INSTRUCTOR
  COORDINADOR
}