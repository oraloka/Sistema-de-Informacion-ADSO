generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id           Int     @id @default(autoincrement())
  nombre       String
  correo       String  @unique
  password     String
  rol          Rol     @default(INSTRUCTOR)
  telefono     String
  aprobaciones Ficha[] @relation("CoordinadorAprobaciones")
  fichas       Ficha[] @relation("InstructorFichas")
}

model Ficha {
  id            Int      @id @default(autoincrement())
  codigo        String   @unique
  programa      String
  duracion      Int
  modalidad     String
  fechaInicio   DateTime
  fechaFin      DateTime
  estado        String   @default("pendiente")
  observacion   String?
  createdAt     DateTime @default(now())
  instructorId  Int
  coordinadorId Int?
  coordinador   Usuario? @relation("CoordinadorAprobaciones", fields: [coordinadorId], references: [id])
  instructor    Usuario  @relation("InstructorFichas", fields: [instructorId], references: [id])
}

enum Rol {
  INSTRUCTOR
  COORDINADOR
}
